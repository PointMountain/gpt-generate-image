{
  "name": "gpt-image-workbench",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "type": "module",
  "bin": {
    "tokencanvas": "src/cli/main.tsx"
  },
  "scripts": {
    "cli": "tsx src/cli/main.tsx",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "test:e2e": "node ./scripts/run-playwright-e2e.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.63",
    "@inkjs/ui": "^2.0.0",
    "ai": "^6.0.176",
    "ink": "^5.2.1",
    "pastel": "^3.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.21.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.1",
    "@rollup/wasm-node": "^4.60.3",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.3.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.2.2",
    "ink-testing-library": "^4.0.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "overrides": {
      "rollup": "npm:@rollup/wasm-node@4.60.3"
    }
  }
}
