{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "vite.config.ts",
    "src/cli/**/*.ts",
    "src/cli/**/*.tsx",
    "src/worker/**/*.ts",
    "src/lib/openai/ai-sdk-image-client.ts",
    "src/lib/openai/image-file-adapter.ts",
    "src/lib/openai/node-image-output.ts",
    "src/lib/openai/openai-dev-proxy.ts",
    "src/lib/openai/openai-endpoint.ts",
    "src/lib/openai/openai-option-sets.ts",
    "src/lib/openai/proxy-aware-fetch.ts",
    "src/lib/openai/response-normalizer.ts"
  ],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
